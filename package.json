{
  "name": "chatgpt-appearance-manager",
  "version": "1.0.0",
  "description": "A cross-platform GUI desktop application to customize ChatGPT appearance with themes, fonts, and layout tweaks",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "chatgpt",
    "customization",
    "themes",
    "appearance",
    "electron"
  ],
  "author": "ChatGPT Appearance Manager",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.chatgpt.appearance-manager",
    "productName": "ChatGPT Appearance Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "themes/**/*",
      "icons/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "icons/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icons/icon.png",
      "category": "Utility"
    }
  }
}
